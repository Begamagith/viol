export interface GeneratedChordVoicing {
  rootNoteEn: string;
  chordName: string;
  chordType: ChordTypeDefinition;
  shapeId: 'C' | 'A' | 'G' | 'E' | 'D';
  shapeNamePt: string;
  frets: number[]; // 6 strings: -1 (mute), 0..19
  fingers: (number | null)[];
  intervalsByString: (string | null)[];
  notesByString: (string | null)[];
  rootStringIndex: number; // 0=6th, 1=5th, 2=4th
  rootFret: number;
  minFret: number;
  maxFret: number;
  barre: boolean;
  barreFret: number | null;
  tipPt: string;
}

/**
 * Given any root note (e.g. "C", "F#", "Bb") and chord type (e.g. "maj7", "dom7"),
 * calculates all 5 CAGED voicings with accurate frets, note names, and intervals.
 */
/**
 * Helper to calculate how many semitones a string is altered from standard tuning (low-to-high index 0..5)
 */
function getTuningDeltaFromStandard(stringIdxLowToHigh: number, currentOpenNoteEn: string): number {
  const STANDARD_LOW_TO_HIGH = ['E', 'A', 'D', 'G', 'B', 'E'];
  const stdNote = STANDARD_LOW_TO_HIGH[stringIdxLowToHigh] || 'E';
  const stdSemi = NOTE_TO_SEMITONE[stdNote] ?? 0;
  const curSemi = NOTE_TO_SEMITONE[currentOpenNoteEn] ?? 0;
  let delta = curSemi - stdSemi;
  if (delta > 6) delta -= 12;
  if (delta < -6) delta += 12;
  return delta;
}

export function generateCagedVoicings(
  rootNoteEn: string,
  chordTypeId: string,
  tuningNotes: string[] = ['E', 'A', 'D', 'G', 'B', 'E']
): GeneratedChordVoicing[] {
  const chordType = CHORD_TYPES.find((ct) => ct.id === chordTypeId) || CHORD_TYPES[0];
  const templates = CAGED_VOICING_TEMPLATES[chordTypeId] || CAGED_VOICING_TEMPLATES['maior'];

  // Convert tuningNotes from high-to-low (0 = 1st string, 5 = 6th string) to low-to-high (0 = 6th string, 5 = 1st string)
  const lowToHighNotes = [...tuningNotes].reverse();

  const results: GeneratedChordVoicing[] = [];

  templates.forEach((tpl) => {
    // 1. Determine which string has the root note for this CAGED shape
    // rootStringIdx: 0 = 6th string E, 1 = 5th string A, 2 = 4th string D
    const stringIdx = tpl.rootStringIdx; // 0, 1, or 2
    const openNoteRoot = lowToHighNotes[stringIdx] || 'E';

    // Find the fret where openNoteRoot matches rootNoteEn
    let foundRootFret = 0;
    for (let f = 0; f <= 15; f++) {
      const info = getNoteAtFret(openNoteRoot, f);
      if (info.noteEn === rootNoteEn) {
        foundRootFret = f;
        break;
      }
    }

    const rootTuningDelta = getTuningDeltaFromStandard(tpl.rootStringIdx, openNoteRoot);

    const validFrets: number[] = [];
    const notesByString: (string | null)[] = [];
    let minF = 999;
    let maxF = -1;

    // Calculate tuning shift for each string relative to root string in the chosen tuning
    const stringShifts = tpl.offsets.map((off, idx) => {
      if (off === null) return 0;
      const strDelta = getTuningDeltaFromStandard(idx, lowToHighNotes[idx] || 'E');
      return rootTuningDelta - strDelta;
    });

    // Check lowest offset among non-null strings
    let lowestOffset = 0;
    tpl.offsets.forEach((off, idx) => {
      if (off !== null) {
        const adjustedOff = off + stringShifts[idx];
        if (adjustedOff < lowestOffset) {
          lowestOffset = adjustedOff;
        }
      }
    });

    // Adjust octave if too low
    if (foundRootFret + lowestOffset < 0) {
      foundRootFret += 12;
    }
    // Or if it goes beyond fret 17, try -12 if possible
    let highestOffset = 0;
    tpl.offsets.forEach((off, idx) => {
      if (off !== null) {
        const adjustedOff = off + stringShifts[idx];
        if (adjustedOff > highestOffset) {
          highestOffset = adjustedOff;
        }
      }
    });
    if (foundRootFret + highestOffset > 16 && foundRootFret - 12 + lowestOffset >= 0) {
      foundRootFret -= 12;
    }

    // Now calculate exact frets for each of the 6 strings
    tpl.offsets.forEach((off, idx) => {
      if (off === null) {
        validFrets.push(-1);
        notesByString.push(null);
      } else {
        const actualFret = Math.max(0, foundRootFret + off + stringShifts[idx]);
        validFrets.push(actualFret);
        const info = getNoteAtFret(lowToHighNotes[idx], actualFret);
        notesByString.push(info.noteEn);
        if (actualFret > 0 && actualFret < minF) {
          minF = actualFret;
        }
        if (actualFret > maxF) {
          maxF = actualFret;
        }
      }
    });

    if (minF === 999) minF = 0;
    if (maxF === -1) maxF = 0;

    // Determine barreFret if barre is true and minF > 0
    const barreFret = tpl.barre && minF > 0 ? minF : null;

    results.push({
      rootNoteEn,
      chordName: `${rootNoteEn}${chordType.suffix}`,
      chordType,
      shapeId: tpl.shapeId,
      shapeNamePt: tpl.shapeNamePt,
      frets: validFrets,
      fingers: tpl.fingers,
      intervalsByString: tpl.intervals,
      notesByString,
      rootStringIndex: tpl.rootStringIdx,
      rootFret: foundRootFret,
      minFret: minF,
      maxFret: maxF,
      barre: tpl.barre,
      barreFret,
      tipPt: tpl.tipPt,
    });
  });

  return results;
}

