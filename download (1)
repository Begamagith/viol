export interface CAGEDVoicingTemplate {
  shapeId: 'C' | 'A' | 'G' | 'E' | 'D';
  shapeNamePt: string;
  rootStringIdx: number; // 0 = 6th string (E), 1 = 5th string (A), 2 = 4th string (D)
  // offsets from root fret on string6 to string1 (-1 or null means muted)
  offsets: (number | null)[];
  fingers: (number | null)[];
  intervals: (string | null)[];
  barre: boolean;
  tipPt: string;
}

